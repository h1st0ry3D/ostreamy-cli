#!/bin/bash
# Watch for Moonlight activity and switch the layout around it.
#
# Signals (see docs/DESIGN.md for the evidence behind each one):
#   on  - a live connection (ESTAB/CLOSE-WAIT/SYN) on Sunshine's ports, a *new*
#         remote endpoint appearing (a fresh client), or "New streaming session
#         started" in sunshine.log
#   off - "CLIENT DISCONNECTED"/"Streaming session ended" in sunshine.log,
#         Sunshine stopping, or a manual `ostreamy off`
#
# Live sockets are not a session signal: Moonlight's control connections close
# right after an app launches, so a real session spends most of its time with no
# live socket. The layout is therefore disarmed by Sunshine's own log, never by a
# quiet socket table.

set -u
SELF_DIR=$(cd "$(dirname "${BASH_SOURCE[0]}")" && pwd)
for cand in "$SELF_DIR/../lib/ostreamy/common.sh" "$SELF_DIR/common.sh"; do
  # shellcheck disable=SC1090
  [ -f "$cand" ] && { . "$cand"; break; }
done

OSTREAMY=${OSTREAMY:-$(command -v ostreamy || echo "$SELF_DIR/ostreamy")}

log() { printf '%s %s\n' "$(date +%H:%M:%S)" "$*"; }

resolve_sig
"$OSTREAMY" ensure >/dev/null 2>&1 || true
log "watching Moonlight activity (poll ${INTERVAL}s, quiet ${QUIET}s)"

activated=0
activated_at=0
drift_since=0
quiet_until=0
log_offset=$(log_size)
scan_offset=$log_offset

while :; do
  resolve_sig
  now=$(date +%s)
  live=$(live_connections)
  fresh=0
  new_endpoints && fresh=1
  session_started=0
  log_since "$scan_offset" 'New streaming session started' && session_started=1

  if [ "$activated" -eq 0 ]; then
    trigger=0
    [ "$live" -gt 0 ] && trigger=1
    # A short-lived connection right after a session ends is usually Moonlight
    # polling its host list, not a new stream: do not re-arm during the quiet window.
    [ "$fresh" -eq 1 ] && [ "$now" -ge "$quiet_until" ] && trigger=1
    [ "$session_started" -eq 1 ] && trigger=1

    if [ "$trigger" -eq 1 ]; then
      log "client connected -> stream-ready layout"
      "$OSTREAMY" on >/dev/null 2>&1 || log "layout switch failed"
      activated=1
      activated_at=$now
      drift_since=0
      log_offset=$(log_size)
      # Settle: the connection that armed us can still be entering TIME-WAIT, so
      # its endpoint may land after this poll's snapshot. Ignore novelty briefly, or
      # that same client counts as "new" and re-arms a manual `off`.
      quiet_until=$((now + 2))
    elif [ "$session_started" -eq 1 ]; then
      # Session began while the layout was idle: Sunshine is capturing an empty
      # STREAM and will deliver one stale frame. Switch and rebuild the capture.
      log "session started while idle -> switching and restarting Sunshine"
      "$OSTREAMY" on >/dev/null 2>&1 || true
      systemctl --user restart sunshine >/dev/null 2>&1 || true
      activated=1
      activated_at=$now
      drift_since=0
      log_offset=$(log_size)
    else
      # Do not fight a deliberate `ostreamy on`: only a *native* layout should
      # have focus on the panel.
      focused=$(monitors | jq -r '[.[] | select(.focused)][0].name // empty')
      if [ "$focused" = "$OUTPUT" ] && ! mirror_active; then
        log "focus left on $OUTPUT while idle -> restoring panel"
        "$OSTREAMY" fix >/dev/null 2>&1 || true
      fi
    fi
  else
    if log_since "$log_offset" 'CLIENT DISCONNECTED|Streaming session ended'; then
      log "Sunshine reported disconnect -> native layout"
      OSTREAMY_INTERNAL=1 "$OSTREAMY" off >/dev/null 2>&1 || log "layout restore failed"
      activated=0
      quiet_until=$((now + QUIET))
      drift_since=0
    elif ! systemctl --user is-active --quiet sunshine 2>/dev/null; then
      log "Sunshine is not running -> native layout"
      OSTREAMY_INTERNAL=1 "$OSTREAMY" off >/dev/null 2>&1 || true
      activated=0
      quiet_until=$((now + QUIET))
      drift_since=0
    elif [ "$(manual_off_since)" -ge "$activated_at" ]; then
      # The user ran ostreamy off. Stay native; a new session still arms.
      log "layout switched off externally -> standby"
      activated=0
      quiet_until=$((now + QUIET))
      drift_since=0
      remember_endpoints
    elif ! mirror_active || [ "$(windows_on_panel)" -gt 0 ]; then
      # No live socket is required here: Moonlight's control sockets close right
      # after launch, so during a real session live is 0. Judge by the layout
      # itself, and give the switch a moment to settle before recovering.
      if [ "$drift_since" -eq 0 ]; then
        drift_since=$now
      elif [ $((now - drift_since)) -ge 2 ]; then
        log "stream layout drifted -> moving windows back to $OUTPUT"
        "$OSTREAMY" recover >/dev/null 2>&1 || true
        drift_since=$now
      fi
    else
      drift_since=0
    fi
  fi

  remember_endpoints
  scan_offset=$(log_size)
  sleep "$INTERVAL"
done
