# Ostreamy configuration. Sourced by every Ostreamy command; plain bash.

# Name of the persistent headless output that Sunshine captures.
# Must match `output_name` in ~/.config/sunshine/sunshine.conf.
OUTPUT=STREAM

# Mode of that headless output, WIDTHxHEIGHT@HZ. 16:10 (1200p, 1600p) fills a Steam
# Deck OLED panel exactly; 1440p gives a 16:9 image with 40 px bars top and bottom on
# the Deck but a pixel-perfect picture on a 1440p desktop monitor. Change it with
# `ostreamy mode 1920x1200@90`; that also updates the Hyprland rule.
MODE=1920x1200@60

# Scale of that headless output. Keep it at 1. A monitor rule that omits `scale`
# gets Hyprland's auto scale, which resolves to 2 on a headless 1920x1200 output
# (2560x1440 too): every window then renders into a 960x600 logical desktop and the
# client sees a zoomed, soft picture. Ostreamy passes `SCALE` on every `hl.monitor`
# call it makes, so a stray SUPER + / (Omarchy's monitor scaling, which acts on the
# focused monitor -- `STREAM` while streaming) is undone at the next switch-on.
SCALE=1

# X position the headless output is parked at while idle, in the monitor layout.
# It must stay well clear of the panel: Hyprland clamps the pointer to the nearest
# monitor, and a parked output flush against the panel becomes reachable at the
# shared edge (follow_mouse then focuses it and activates its workspace, which looks
# like "the mouse at the border switches workspace"). Leave a gap of at least 600 px;
# the default leaves thousands on a 2560-wide panel. Ostreamy widens it automatically
# when the panel's own right edge would come within 1500 px.
PARK_X=6000

# Seconds after a switch-off during which *new short-lived* connections (Moonlight
# menu/status polling after the user quits) cannot re-arm the layout. A real session
# still arms it: a live connection or "New streaming session started" bypasses this.
QUIET=20

# Poll interval for the watcher, seconds.
INTERVAL=0.25

# Sunshine control ports (TCP), used to detect client activity.
PORTS="47984 47989 48010"

# Seconds to let Hyprland settle between layout steps during a switch.
PUMP=1
